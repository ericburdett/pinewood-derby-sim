ut of speed.\n215:    if len(result.trajectory) == 1 and result.trajectory[0].position == 0.0:\n222:    jargon scan exercises every coaching branch (PRD AC-X3 'across a matrix of designs:\n250:    assert tip.outcome is Outcome.DNF and len(tip.trajectory) == 1\n251:    assert tip.trajectory[0].position == 0.0 and tip.energy.w_gravity == 0.0\n254:    assert stall.outcome is Outcome.DNF and len(stall.trajectory) > 1\n258:# AC-2 — A reusable banned-terms checker is exposed from pinewood_derby.present so the\n261:def test_banned_terms_list_is_exposed_and_nonempty() -> None:\n262:    \"\"\"``pinewood_derby.present`` exposes a shared ``BANNED_TERMS`` collection of jargon\n264:    from pinewood_derby.present import BANNED_TERMS\n266:    terms = list(BANNED_TERMS)\n267:    assert len(terms) > 0, \"BANNED_TERMS must be a non-empty list of jargon strings\"\n269:        \"every banned term must be a non-empty string\"\n273:def test_find_banned_terms_is_exposed_and_callable() -> None:\n274:    \"\"\"``find_banned_terms(text) -> list[str]`` is the exposed reusable checker the UI\n276:    from pinewood_derby.present import find_banned_terms","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
