{"type":"system","subtype":"task_started","task_id":"wmvfcp1vv","tool_use_id":"toolu_01TemfA69jALyRfkS84CJHSs","description":"Deterministic TDD build loop for one approved feature: PO decompose -> (QA red -> dev green -> QA validate -> adversarial review)* -> PO sign-off. Returns structured results for the run-record. Starts AFTER PRD/TRD approval; ends at the PO sign-off verdict (the human accept-gate happens in the main conversation).","task_type":"local_workflow","workflow_name":"build-loop","prompt":"export const meta = {\n  name: 'build-loop',\n  description: 'Deterministic TDD build loop for one approved feature: PO decompose -> (QA red -> dev green -> QA validate -> adversarial review)* -> PO sign-off. Returns structured results for the run-record. Starts AFTER PRD/TRD approval; ends at the PO sign-off verdict (the human accept-gate happens in the main conversation).',\n  phases: [\n    { title: 'Decompose', detail: 'PO turns the approved PRD/TRD into a testable backlog' },\n    { title: 'Build', detail: 'per work item: QA red -> dev green -> QA validate' },\n    { title: 'Review', detail: 'adversarial review loop until clean or capped' },\n    { title: 'Sign-off', detail: 'PO acceptance vs PRD/TRD' },\n  ],\n}\n\n// ── inputs (args) ─────────────────────────────────────────────────────────────\n// { app, feature, prdRef, trdRef, profileRef, gatesRef?, caps?, severityThreshold? }\n// Refs are PATHS the agents READ themselves (the workflow runtime has no filesystem).\nconst A = typeof args === 'string' ? JSON.parse(args || '{}') : (args || {})\nif (!A.prdRef || !A.trdRef || !A.profileRef) {\n  throw new Error('build-loop requires args.prdRef, args.trdRef, args.profileRef (paths the agents will read)')\n}\nconst GATES = A.gatesRef || 'agentic-sdlc/gates.md'\nconst caps = Object.assign({ green: 6, adversarial: 3 }, A.caps || {})\nconst SEV = { critical: 4, high: 3, medium: 2, low: 1 }\nconst THRESHOLD = SEV[A.severityThreshold || 'high']\nconst ctx =\n  `App profile: ${A.profileRef}\\n` +\n  `Approved PRD: ${A.prdRef}\\n` +\n  `Approved TRD: ${A.trdRef}\\n` +\n  `Gate criteria (your definition of done): ${GATES}\\n` +\n  `Read these files yourself before acting.` +\n  // Optional incremental-build scope: when set, prior work items are already built and\n  // GREEN; the PO decomposes only the remaining acceptance criteria and no agent\n  // rebuilds or weakens existing passing tests. Empty on a from-scratch build.\n  (A.scopeNote ? `\\n\\nINCREMENTAL BUILD SCOPE — read and honor before acting:\\n${A.scopeNote}` : '')\n\n// ── gate verdict schemas (mirror gates.md) ───────────────────────────────────\nconst BACKLOG = { type: 'object', required: ['work_items'], properties: { work_items: { type: 'array', items: {\n  type: 'object', required: ['id', 'title', 'acceptance_criteria'], properties: {\n    id: { type: 'string' }, title: { type: 'string' },\n    acceptance_criteria: { type: 'array', items: { type: 'string' } },\n    depends_on: { type: 'array', items: { type: 'string' } } } } } } }\n\nconst RED = { type: 'object', required: ['red_confirmed', 'tests'], properties: {\n  red_confirmed: { type: 'boolean' }, deterministic: { type: 'boolean' },\n  tests: { type: 'array', items: { type: 'object', required: ['criterion', 'test_id', 'failing'], properties: {\n    criterion: { type: 'string' }, test_id: { type: 'string' },\n    failing: { type: 'boolean' }, fails_for_right_reason: { type: 'boolean' } } } },\n  notes: { type: 'string' } } }\n\nconst GREEN = { type: 'object', required: ['green', 'tests_unmodified'], properties: {\n  green: { type: 'boolean' }, lint_pass: { type: 'boolean' }, typecheck_pass: { type: 'boolean' },\n  tests_unmodified: { type: 'boolean' }, summary: { type: 'string' } } }\n\nconst VALIDATE = { type: 'object', required: ['validated', 'criteria'], properties: {\n  validated: { type: 'boolean' }, coverage: { type: 'number' },\n  criteria: { type: 'array', items: { type: 'object', required: ['criterion', 'passing'], properties: {\n    criterion: { type: 'string' }, covered_by: { type: 'array', items: { type: 'string' } },\n    passing: { type: 'boolean' } } } },\n  unmapped: { type: 'array', items: { type: 'string' } } } }\n\nconst ADVERSARIAL = { type: 'object', required: ['findings'], properties: {\n  findings: { type: 'array', items: { type: 'object', required: ['id', 'category', 'severity', 'reproducible'], properties: {\n    id: { type: 'string' }, category: { type: 'string' },\n    severity: { type: 'string', enum: ['critical', 'high', 'medium', 'low'] },\n    description: { type: 'string' }, repro: { type: 'string' }, reproducible: { type: 'boolean' } } } },\n  categories_checked: { type: 'array', items: { type: 'string' } } } }\n\nconst SIGNOFF = { type: 'object', required: ['signed_off', 'criteria'], properties: {\n  signed_off: { type: 'boolean' },\n  criteria: { type: 'array', items: { type: 'object', required: ['criterion', 'met'], properties: {\n    criterion: { type: 'string' }, met: { type: 'boolean' }, evidence: { type: 'string' } } } },\n  unmet: { type: 'array', items: { type: 'string' } },\n  nfr: { type: 'array', items: { type: 'object', properties: {\n    name: { type: 'string' }, met: { type: 'boolean' }, evidence: { type: 'string' } } } } } }\n\n// ── helper: developer iterates to GREEN (capped) ─────────────────────────────\nasync function devToGreen(item, intent, phaseName, startAttempt) {\n  let attempts = startAttempt || 0\n  let green = null\n  while (attempts < caps.green) {\n    attempts++\n    green = await agent(\n      `You are the Developer. ${intent}\\n${ctx}\\n` +\n      `Work item: ${item.id} — ${item.title}\\n` +\n      `Run the profile's test/lint/typecheck commands. NEVER modify, skip, or delete tests. ` +\n      `Apply the Developer gate in ${GATES}. Attempt ${attempts}/${caps.green}.`,\n      { agentType: 'developer', phase: phaseName, label: `dev:${item.id}#${attempts}`, schema: GREEN }\n    )\n    if (green && green.green && green.tests_unmodified) break\n  }\n  return { green, attempts }\n}\n\n// ── 0. Decompose ─────────────────────────────────────────────────────────────\nphase('Decompose')\nconst backlog = await agent(\n  `You are the Product Owner. ${ctx}\\n` +\n  `Decompose the approved PRD/TRD into independently testable, vertically-sliced work items, each ` +\n  `with acceptance criteria traceable to a PRD line. Apply the \"PO Decompose\" gate in ${GATES}.`,\n  { agentType: 'product-owner', label: 'po:decompose', schema: BACKLOG }\n)\nconst items = backlog.work_items || []\nlog(`Decomposed into ${items.length} work item(s)`)\n\n// ── 1–4. Build each item SEQUENTIALLY (shared mutable codebase → no parallel/worktree in v1) ──\nconst results = []\nfor (const item of items) {\n  phase('Build')\n  const red = await agent(\n    `You are QA. ${ctx}\\nWork item: ${item.id} — ${item.title}\\n` +\n    `Acceptance criteria:\\n- ${(item.acceptance_criteria || []).join('\\n- ')}\\n` +\n    `Write failing tests for every criterion. Apply the \"QA Red\" gate in ${GATES} — confirm true RED.`,\n    { agentType: 'qa', phase: 'Build', label: `qa-red:${item.id}`, schema: RED }\n  )\n\n  let { green, attempts } = await devToGreen(item, 'Make the failing tests pass.', 'Build', 0)\n\n  const validate = await agent(\n    `You are QA. ${ctx}\\nWork item: ${item.id} — ${item.title}\\n` +\n    `Validate the implementation against the acceptance criteria. Apply the \"QA Validate\" gate in ${GATES}.`,\n    { agentType: 'qa', phase: 'Build', label: `qa-validate:${item.id}`, schema: VALIDATE }\n  )\n\n  // ── adversarial loop ──\n  phase('Review')\n  let iteration = 0\n  let adv = null\n  let escalated = false\n  while (true) {\n    adv = await agent(\n      `You are the Adversarial Reviewer. ${ctx}\\nWork item: ${item.id} — ${item.title}\\n` +\n      `Work the full coverage checklist in ${GATES} and try to break it. Findings must be reproducible. ` +\n      `Review pass #${iteration}.`,\n      { agentType: 'adversarial-reviewer', phase: 'Review', label: `adv:${item.id}#${iteration}`, schema: ADVERSARIAL }\n    )\n    const open = (adv.findings || []).filter(f => f.reproducible && SEV[f.severity] >= THRESHOLD)\n    if (open.length === 0) break\n    if (iteration >= caps.adversarial) {\n      escalated = true\n      log(`Adversarial cap (${caps.adversarial}) hit on ${item.id} with ${open.length} open finding(s) — escalating`)\n      break\n    }\n    await agent(\n      `You are QA. ${ctx}\\nWork item: ${item.id} — ${item.title}\\n` +\n      `Write covering failing tests for these confirmed adversarial findings, then stop:\\n` +\n      `${JSON.stringify(open, null, 2)}\\nApply the \"QA Red\" gate.`,\n      { agentType: 'qa', phase: 'Review', label: `qa-edge:${item.id}#${iteration}`, schema: RED }\n    )\n    const fix = await devToGreen(item, 'fix: make the new edge-case tests pass without weakening any test.', 'Review', attempts)\n    attempts = fix.attempts\n    green = fix.green\n    iteration++\n  }\n\n  results.push({\n    item, red, green, validate,\n    adversarial: adv, adversarial_iterations: iteration,\n    dev_attempts: attempts, escalated,\n  })\n}\n\n// ── 5. PO Sign-off (verdict returned to the main conversation for the human accept-gate) ──\nphase('Sign-off')\nconst signoff = await agent(\n  `You are the Product Owner. ${ctx}\\n` +\n  `Final sign-off: does the built feature meet EVERY PRD/TRD acceptance criterion and the profile NFRs, ` +\n  `with evidence? Apply the \"PO Sign-off\" gate in ${GATES}. You are a protective gate — never relax the bar.`,\n  { agentType: 'product-owner', label: 'po:signoff', schema: SIGNOFF }\n)\n\nreturn {\n  app: A.app,\n  feature: A.feature,\n  backlog,\n  results,\n  signoff,\n  escalated: results.some(r => r.escalated) || !signoff.signed_off,\n}\n","uuid":"59830f84-a6c1-4fd1-aa05-2f2b22b1937b","session_id":"55f4d0f9-3f78-404c-9d9b-b1c51c035e71"}
