f\",\n91\t      \"acceptance_criteria_refs\": [\"AC-P1\", \"AC-P2\", \"AC-P3\", \"AC-P4\"],\n92\t      \"red_green_attempts\": 2,\n93\t      \"adversarial_iterations\": 2,\n94\t      \"findings\": { \"total\": 6, \"critical\": 0, \"high\": 3, \"medium\": 1, \"low\": 2 },\n95\t      \"final_state\": \"passed\"\n96\t    },\n97\t    {\n98\t      \"id\": \"WI-7\",\n99\t      \"title\": \"Wheels / rotational-inertia lever: fewer and lighter wheels are faster; rotational KE share correct\",\n100\t      \"acceptance_criteria_refs\": [\"AC-WH1\", \"AC-WH2\", \"AC-E2\"],\n101\t      \"red_green_attempts\": 5,\n102\t      \"adversarial_iterations\": 3,\n103\t      \"findings\": { \"total\": 5, \"critical\": 0, \"high\": 4, \"medium\": 1, \"low\": 0 },\n104\t      \"final_state\": \"passed\"\n105\t    },\n106\t    {\n107\t      \"id\": \"WI-8\",\n108\t      \"title\": \"Aerodynamics lever: lower drag is faster; drag energy scales with C_d, frontal area, flat length\",\n109\t      \"acceptance_criteria_refs\": [\"AC-A1\", \"AC-A2\"],\n110\t      \"red_green_attempts\": 2,\n111\t      \"adversarial_iterations\": 0,\n112\t      \"findings\": { \"total\": 0, \"critical\": 0, \"high\": 0, \"medium\": 0, \"low\": 0 },\n113\t      \"final_state\": \"passed\"\n114\t    },\n115\t    {\n116\t      \"id\": \"WI-9\",\n117\t      \"title\": \"Axle-friction lever: polished+graphite faster; axle force/energy follow the spec formula and scale with mu\",\n118\t      \"acceptance_criteria_refs\": [\"AC-F1\", \"AC-F2\"],\n119\t      \"red_green_attempts\": 0,\n120\t      \"adversarial_iterations\": 0,\n121\t      \"findings\": { \"total\": 1, \"critical\": 0, \"high\": 0, \"medium\": 1, \"low\": 0 },\n122\t      \"final_state\": \"passed\"\n123\t    },\n124\t    {\n125\t      \"id\": \"WI-10\",\n126\t      \"title\": \"Alignment / rail lever: RAIL_RIDER beats STRAIGHT; seeded ping-pong in range and reproducible\",\n127\t      \"acceptance_criteria_refs\": [\"AC-AL1\", \"AC-AL2\", \"AC-AL3\"],\n1